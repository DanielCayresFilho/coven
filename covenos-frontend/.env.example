# ==============================================
# FRONTEND - COVENOS (Nuxt 3)
# ==============================================
# Copie este arquivo para .env na raiz de covenos-frontend/
# cp .env.example .env

# ----------------------------------------------
# API Backend - OBRIGATÓRIO
# ----------------------------------------------
# URL base do backend (sem /api no final — o Nuxt adiciona automaticamente)
#
# Desenvolvimento local:
NUXT_PUBLIC_API_URL=http://localhost:3009

# Produção (exemplo):
# NUXT_PUBLIC_API_URL=https://api.seudominio.com.br

# Variável alternativa (legado — prefira NUXT_PUBLIC_API_URL)
# NUXT_PUBLIC_API_BASE=http://localhost:3009

# ----------------------------------------------
# Aplicação
# ----------------------------------------------
# Porta do servidor de desenvolvimento Nuxt
NUXT_PORT=3010
