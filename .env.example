# ==============================================
# DOCKER COMPOSE CONFIGURATION
# ==============================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=coven
MYSQL_USER=coven_user
MYSQL_PASSWORD=your_secure_password_here

# Port Mappings
MYSQL_PORT=3307
BACKEND_PORT=3009
FRONTEND_PORT=3010

# ==============================================
# BACKEND CONFIGURATION
# ==============================================

# Environment
NODE_ENV=production

# Database URL (will be constructed from MySQL vars above)
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@db:3306/${MYSQL_DATABASE}

# JWT Secret (REQUIRED - generate a strong random string)
JWT_SECRET=your-secret-key-change-me

# Application Port (internal container port)
PORT=3000

# CORS - origens permitidas (URL do frontend, separadas por vírgula)
# Produção: https://seu-dominio-frontend.com
CORS_ORIGINS=http://localhost:3010

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================

# API URL (adjust for your domain)
# For Coolify, use: https://your-backend-domain.com
# For local: http://localhost:3009
NUXT_PUBLIC_API_URL=http://localhost:3009

# Nuxt Port (internal container port)
NUXT_PORT=3000

# ==============================================
# BACKUP CONFIGURATION
# ==============================================

# SQL backup file to be loaded on first run
MYSQL_INIT_SCRIPT=./coven_backup_20251023.sql
