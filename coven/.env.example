# ==============================================
# BACKEND - COVEN (NestJS)
# ==============================================
# Copie este arquivo para .env na raiz de coven/
# cp .env.example .env

# ----------------------------------------------
# Database (MySQL) - OBRIGATÓRIO
# ----------------------------------------------
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Desenvolvimento local (MySQL na porta 3307 via Docker):
DATABASE_URL="mysql://coven_user:your_password@localhost:3307/coven"

# ----------------------------------------------
# Ambiente
# ----------------------------------------------
NODE_ENV=development

# ----------------------------------------------
# Aplicação
# ----------------------------------------------
# Porta HTTP do backend
# Local: 3009 | Docker (container interno): 3000
PORT=3009

# ----------------------------------------------
# Autenticação JWT - OBRIGATÓRIO
# ----------------------------------------------
# Gere uma chave forte para produção, por exemplo:
# openssl rand -base64 32
JWT_SECRET=your-secret-key-change-me

# ----------------------------------------------
# CORS
# ----------------------------------------------
# Origens permitidas (separadas por vírgula). Deve incluir a URL do frontend.
# Omita ou deixe vazio em dev para aceitar qualquer origem.
CORS_ORIGINS=http://localhost:3010
